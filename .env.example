# Copia questo file in .env.local e inserisci i valori reali (non committare .env.local)

# Dominio pubblico del sito (usato per sitemap, Open Graph e dati strutturati)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Metti "production" solo sul sito pubblicato: abilita l'indicizzazione nei motori di ricerca
NEXT_PUBLIC_SITE_ENV=development

# Dove inviare le richieste di analisi (webhook di Make, Zapier, n8n, CRM...). Obbligatorio per il modulo.
LEAD_WEBHOOK_URL=

# Recapiti pubblici: se compilati sostituiscono quelli predefiniti in lib/site.ts
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Numero WhatsApp in formato internazionale, solo cifre (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Pagina dell'informativa privacy approvata
NEXT_PUBLIC_PRIVACY_URL=
