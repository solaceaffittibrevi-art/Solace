# Copia questo file in .env.local e inserisci i valori reali (non committare .env.local)

# Dominio pubblico del sito (usato per sitemap, Open Graph e dati strutturati)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In produzione: https://<dominio-confermato>. Dominio definitivo ancora da confermare: finché manca,
# lasciare vuoto su Vercel (si usa l'indirizzo *.vercel.app).
# Metti "production" solo sul sito pubblicato con il dominio confermato: abilita l'indicizzazione nei motori di ricerca
NEXT_PUBLIC_SITE_ENV=development

# Ricezione delle richieste di valutazione: serve ALMENO UNO dei due canali.
# 1) Webhook (Make, Zapier, n8n, CRM...)
LEAD_WEBHOOK_URL=
# Codice condiviso con il ricevente del webhook (es. Google Apps Script in scripts/google-apps-script):
# genera un valore casuale, ad esempio con: openssl rand -hex 24
LEAD_WEBHOOK_SECRET=
# 2) Email tramite Resend (resend.com): chiave API e indirizzo che riceve le richieste.
#    Senza dominio verificato su Resend lasciare LEAD_EMAIL_FROM vuoto: si usa onboarding@resend.dev, che
#    consegna SOLO all'email dell'account Resend (quindi l'account va creato con solace.gestione@gmail.com).
#    Con un dominio verificato: LEAD_EMAIL_FROM=Sito Solace <richieste@tuodominio.it>
RESEND_API_KEY=
LEAD_EMAIL_TO=solace.gestione@gmail.com
LEAD_EMAIL_FROM=
# Solo per i test con un servizio email simulato: sul sito pubblicato lasciare vuoto.
RESEND_API_URL=

# Limite alle richieste e protezione dai doppi invii, condivisi tra tutte le istanze: Upstash Redis.
# Obbligatorio sul sito pubblicato (Vercel o NEXT_PUBLIC_SITE_ENV=production): senza, il modulo
# risponde con un errore e non accetta richieste. In sviluppo locale si usa la memoria.
# L'integrazione Upstash di Vercel crea KV_REST_API_URL e KV_REST_API_TOKEN: vanno bene anche quelli.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recapiti pubblici: se compilati sostituiscono quelli predefiniti in lib/site.ts
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Numero WhatsApp in formato internazionale, solo cifre (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 (facoltativo): identificativo di misurazione, es. G-XXXXXXXXXX.
# Lo script viene caricato solo dopo il consenso "statistiche" del visitatore.
NEXT_PUBLIC_GA4_ID=
