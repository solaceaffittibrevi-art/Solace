# Copia questo file in .env.local e inserisci i valori reali (non committare .env.local)

# Dominio pubblico del sito (usato per sitemap, Open Graph e dati strutturati)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Metti "production" solo sul sito pubblicato: abilita l'indicizzazione nei motori di ricerca
NEXT_PUBLIC_SITE_ENV=development

# Ricezione delle richieste di valutazione: serve ALMENO UNO dei due canali.
# 1) Webhook (Make, Zapier, n8n, CRM...)
LEAD_WEBHOOK_URL=
# 2) Email tramite Resend (resend.com): chiave API e indirizzo che riceve le richieste.
#    Per inviare da un indirizzo del proprio dominio va verificato il dominio su Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=solaceaffittibrevi@gmail.com
LEAD_EMAIL_FROM=
# Solo per i test con un servizio email simulato: sul sito pubblicato lasciare vuoto.
RESEND_API_URL=

# Limite alle richieste e protezione dai doppi invii, condivisi tra tutte le istanze: Upstash Redis.
# Obbligatorio sul sito pubblicato (Vercel o NEXT_PUBLIC_SITE_ENV=production): senza, il modulo
# risponde con un errore e non accetta richieste. In sviluppo locale si usa la memoria.
# L'integrazione Upstash di Vercel crea KV_REST_API_URL e KV_REST_API_TOKEN: vanno bene anche quelli.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recapiti pubblici: se compilati sostituiscono quelli predefiniti in lib/site.ts
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Numero WhatsApp in formato internazionale, solo cifre (es. 393331234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Pagina dell'informativa privacy approvata
NEXT_PUBLIC_PRIVACY_URL=
